{
    "layer": "top",
    "position": "top",
    "exclusive": true,

    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "margin-bottom": 0,

    "modules-left": ["sway/workspaces"],
    "modules-center": ["sway/window"],
    "modules-right": ["tray", "pulseaudio", "cpu", "memory", "clock"],

    "reload_style_on_change": true,

    "sway/window": {
        "format": "{app_id}  {title}",
        "icon": false,
        "max-length": 50,
        "tooltip": false
    },

    "sway/workspaces": {
        "format": "{value}",
        "tooltip": false,
        "all-outputs": false,
        "disable-scroll": false
    },

    "tray": {
        "icon-size": 18,
        "spacing": 0
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "tooltip": true,
        "tooltip-format": "Volume: {volume}%",
        "format-icons": {
            "headphone": "",
            "default": ["", "", ""]
        },
        "scroll-step": 5,
        "max-volume": 100,
        "on-click": "pavucontrol"
    },

    "cpu": {
        "interval": 2,
        "format": "CPU {usage}%",
        "tooltip": true
    },

    "memory": {
        "format": "mem: {used:0.1f}G",
        "tooltip": true,
        "tooltip-format": "RAM: Used {used:0.1f}G / Total {total:0.1f}G",
        "interval": 4
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}"
    }
}
